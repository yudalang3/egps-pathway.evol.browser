\code{\link{free_line}}, \code{\link{free_polygon}}, \code{\link{yytree}}
}
\examples{
# free_bezier()
control <- rbind(c(.1, .85), c(.3, .65), c(.6, .95), c(.8, .8))
p <- yytree("(A:1,B:2);") + free_bezier(control, line_color = "purple")

# free_bezier_ring()
upper <- rbind(c(.1, .8), c(.3, .6), c(.6, .9), c(.8, .75))
lower <- upper
lower[, 2] <- lower[, 2] + .05
p <- yytree("(A:1,B:2);") +
  free_bezier_ring(upper, lower, fill_color = "#9370DB80")

}
