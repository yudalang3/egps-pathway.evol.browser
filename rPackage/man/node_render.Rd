% Generated by scripts/generate_yytree_help.R; edit that source instead.
\name{node_render}
\alias{leaf_render}
\alias{inner_node_render}
\title{
Style leaf and internal-node symbols and branches
}
\description{
\strong{\code{leaf_render()}:} Set symbols and incoming-branch colors for all or selected leaves.

\strong{\code{inner_node_render()}:} Set symbols and incoming-branch colors for internal nodes, including the root.
}
\usage{
leaf_render(size = NULL, fill = NULL, df = NULL)
inner_node_render(size = NULL, fill = NULL, df = NULL, name1 = NULL,
    name2 = NULL)
}
\arguments{
\item{size}{Finite nonnegative node radius in logical pixels, not diameter. Default \code{NULL} leaves the existing radius unchanged; initially nodes have radius 0 (no visible node symbol). A supplied \code{df$size} overrides this value for its row.}
\item{fill}{Color for both the node symbol and its incoming branch. Default \code{NULL} retains the existing color (initially black). \code{NA} makes them transparent. A supplied \code{df$fill} overrides this value for its row. An R color name, \code{#RRGGBB} or \code{#RRGGBBAA}; alpha is supported.}
\item{df}{\strong{\code{leaf_render}:} Default \code{NULL} applies supplied \code{size} and \code{fill} to every leaf. Otherwise, a nonempty data frame with unique known leaf \code{name} values and optional \code{size} and \code{fill} columns. Each supplied row field overrides the corresponding function argument.

\strong{\code{inner_node_render}:} Default \code{NULL}. Without selectors, apply supplied styles to all internal nodes. With \code{name1} and \code{name2}, style their MRCA only. Otherwise supply a nonempty data frame with \code{name1} and \code{name2}, and optional \code{size} and \code{fill} columns. Rows select MRCAs and override function-level style values.}
\item{name1}{\strong{\code{inner_node_render} only:} One leaf-name string, default \code{NULL}. To select a single node without \code{df}, supply both \code{name1} and \code{name2}: they must be distinct known leaves and identify their most recent common ancestor (MRCA). With \code{df}, each row supplies both selector columns. Without df, leaving both selectors NULL styles all internal nodes.}
\item{name2}{\strong{\code{inner_node_render} only:} One leaf-name string, default \code{NULL}. To select a single node without \code{df}, supply both \code{name1} and \code{name2}: they must be distinct known leaves and identify their most recent common ancestor (MRCA). With \code{df}, each row supplies both selector columns. Without df, leaving both selectors NULL styles all internal nodes.}
}
\details{
\subsection{leaf_render}{
Only explicitly supplied style fields are changed. A later style layer overrides those fields for its selected leaves. Omitted leaves retain prior styles. \code{leaf_render()} with no arguments has no visible effect. Annotation rows are matched by leaf names, never by row position. Unknown names and duplicate selector rows are rejected when adding the layer.
}
\subsection{inner_node_render}{
Without \code{df}, supply both leaf selectors or neither. With \code{df}, row selectors take precedence over function-level selectors; there is no mutual-exclusion error. Later layers override only their supplied style fields. The root has no incoming branch. Annotation rows are matched by leaf names, never by row position. Unknown names and duplicate selector rows are rejected when adding the layer.
}
}
\section{Similarities and differences}{
Both functions set node radius and incoming-branch color. leaf_render selects tips by name; inner_node_render selects internal nodes by an MRCA leaf pair, or all internal nodes when selectors are absent. Neither function adds annotation text or a clade background.
}
\value{
\describe{
\item{\code{leaf_render()}}{A \code{yytree_layer} value; add it to a plot with \code{+}.}
\item{\code{inner_node_render()}}{A \code{yytree_layer} value; add it to a plot with \code{+}.}
}
}
\seealso{
\code{\link{leaf_label_render}}, \code{\link{inner_node_annotation}}, \code{\link{inner2leaf_highlight}}
}
\examples{
# leaf_render()
p <- yytree("((A:1,B:2):1,C:3);") + leaf_render(size = 3, fill = "blue")
q <- p + leaf_render(size = 4,
  df = data.frame(name = c("A", "C"), fill = c("red", "gold")))

# inner_node_render()
base <- yytree("((A:1,B:2):1,C:3);")
all_nodes <- base + inner_node_render(size = 2, fill = "grey")
one_node <- base + inner_node_render(size = 5, fill = "red",
                                     name1 = "A", name2 = "B")
batch <- base + inner_node_render(size = 3,
  df = data.frame(name1 = "A", name2 = "B", fill = "orange"))

}
