\name{interact}
\alias{interact}
\title{
Attach node hover information
}
\description{
Attach node hover information in the interactive preview.
}
\usage{
interact(df)
}
\arguments{
\item{df}{A nonempty data frame with a unique character or factor name column. Other columns contain tooltip values.}
}
\details{
Matches named leaves, internal nodes and roots exactly. Unknown or ambiguous names are errors. The last interact layer replaces earlier data. Column order is retained. Missing values display as an em dash. Text, numeric, logical, factor and date columns are supported.
}
\value{
A \code{yytree_layer} value; add it to a plot with \code{+}.
}
\seealso{
\code{\link{print.yytree}}, \code{\link{yytree}}
}
