\name{free_heatmap}
\alias{free_heatmap}
\title{
Place a free-position numeric heatmap
}
\description{
Place a numeric matrix in a rectangular region of the canvas.
}
\usage{
free_heatmap(x, y, width, height, matrix, mode = "relative", colors = c("#2166AC",
    "white", "#B2182B"), limits = NULL)
}
\arguments{
\item{x}{Required finite numeric horizontal coordinate of the heatmap's upper-left corner, in the selected mode.}
\item{y}{Required finite numeric vertical coordinate of the heatmap's upper-left corner, in the selected mode.}
\item{width}{Required finite positive total width of the heatmap, in the selected mode; not an individual cell width.}
\item{height}{Required finite positive total height of the heatmap, in the selected mode; not an individual cell height.}
\item{matrix}{Required nonempty numeric matrix. Infinite values are rejected; \code{NA} entries are left blank. Row and column names are ignored; no leaf-name matching is performed.}
\item{mode}{One string: \code{"relative"} (default; canvas width and height are 1), \code{"percent"} (width and height are 100), or \code{"pixel"} (logical pixels). Only positions and geometric widths/heights use this unit; font sizes, gaps and stroke widths remain logical pixels.}
\item{colors}{Vector of R colors interpolated into a continuous palette. Default \code{c("#2166AC", "white", "#B2182B")} (blue, white, red). An R color name, \code{#RRGGBB} or \code{#RRGGBBAA}; alpha is supported.}
\item{limits}{Two finite numbers in increasing or equal order. Default \code{NULL} uses the range of all nonmissing entries in the entire matrix, or \code{c(0, 1)} for an all-missing matrix. Values outside the limits are clipped; equal limits use the palette midpoint. No automatic standardization or Z-score is applied.}
}
\details{
Rows run from top to bottom and columns from left to right. Cells divide the requested rectangle evenly. No labels, borders or legend are added automatically. Use free_text for independent labels or leaf_annotation_heatmap for tracks linked to leaves. Coordinates refer to the entire logical canvas, including margins, not to tree or branch coordinates. The origin is the upper-left corner; x increases rightwards and y downwards. Values outside the canvas are not clamped.
}
\value{
A \code{yytree_layer} value; add it to a plot with \code{+}.
}
\seealso{
\code{\link{leaf_annotation_heatmap}}, \code{\link{free_text}}, \code{\link{yytree}}
}
\examples{
values <- matrix(c(0, 2, NA, 6, 8, 10), nrow = 2)
p <- yytree("(A:1,B:2);") +
  free_heatmap(.65, .8, .25, .12, values, limits = c(0, 10))

}
