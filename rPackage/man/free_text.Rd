% Generated by scripts/generate_yytree_help.R; edit that source instead.
\name{free_text}
\alias{free_text}
\title{
Place free text on the canvas
}
\description{
Place text at a freely chosen canvas coordinate.
}
\usage{
free_text(x, y, text, mode = "relative", locator = "left", gap = 10,
    color = "black", size = 12)
}
\arguments{
\item{x}{Required finite numeric horizontal anchor coordinate, in the unit selected by mode.}
\item{y}{Required finite numeric text-baseline coordinate, in the unit selected by mode.}
\item{text}{Required single nonmissing character string.}
\item{mode}{One string: \code{"relative"} (default; canvas width and height are 1), \code{"percent"} (width and height are 100), or \code{"pixel"} (logical pixels). Only positions and geometric widths/heights use this unit; font sizes, gaps and stroke widths remain logical pixels.}
\item{locator}{One string: \code{"left"} (default) starts the text to the right of \code{x}; \code{"right"} ends it to the left; \code{"center"} centers it on \code{x}. The gap applies only to left and right anchors.}
\item{gap}{One finite numeric horizontal gap in logical pixels, default 10. May be negative; ignored for a centered anchor.}
\item{color}{Text color, default \code{"black"}. \code{NA} hides the text. An R color name, \code{#RRGGBB} or \code{#RRGGBBAA}; alpha is supported.}
\item{size}{One finite positive font size in logical pixels, default 12; independent of mode.}
}
\details{
The y coordinate is the text baseline, not the top of a text box. The font family follows the plot's label font; this function has no separate font-family argument. Coordinates refer to the entire logical canvas, including margins, not to tree or branch coordinates. The origin is the upper-left corner; x increases rightwards and y downwards. Values outside the canvas are not clamped.
}
\value{
A \code{yytree_layer} value; add it to a plot with \code{+}.
}
\seealso{
\code{\link{free_ellipse}}, \code{\link{inner_node_annotation}}, \code{\link{yytree}}
}
\examples{
p <- yytree("(A:1,B:2);") +
  free_text(50, 8, "Tree title", mode = "percent", locator = "center", size = 18)

}
